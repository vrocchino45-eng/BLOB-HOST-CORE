+    }
+    if(!miss&&(mode!=='disabled'||ordinary))visual('after');
+    const events=structuredClone(owner.pairContacts??[]);
+    check(events.length===(miss||mode==='disabled'?0:1),'unexpected mounted impact count '+events.length);
