+  }finally{await context.close();}
+ }
+ await fs.writeFile(path.join(out,'summary.json'),JSON.stringify({status:'PASS',revision:7,commit:rev,chromium:browser.version(),cases},null,2)+'\n');
+}finally{await browser?.close();await server.close();}
+
+function onceModeAssertion(data,mode,miss){
+ assert.equal(data.inventoryQ,8);assert.equal(data.receiptParityAtContact,true);
+ if(miss||mode==='disabled')return;
+ const [event]=data.events;
+ assert.equal(event.fixture,fixtureId(mode));
+ assert.deepEqual(event.actualRecipientIds,admission.scope.ids);
+ assert.equal(data.retrievals.length,2);
+ assert.equal(event.inventoryTransferred,false);assert.equal(event.hostReceipt,false);assert.equal(event.progressionCredit,false);
+ assert.ok(Math.abs(data.geometry.proxyClearance)<1e-10);
+ assert.ok(data.geometry.bodies.every(body=>body.endCenterOffset<1e-10));
+ const record=frictionModel?.fixtures?.[event.fixture];
+ const e=record ? restitution.fixtures[record.normalFixture].restitution : mode==='legacy' ? 0 : .5;
+ assert.equal(event.restitution,mode==='legacy'?undefined:e);
+ const [a,b]=event.units,n=event.normal;
+ const diff=(left,right)=>left.map((v,i)=>v-right[i]);
+ const scale=(v,k)=>v.map(x=>x*k);
+ const dot=(v,w)=>v.reduce((s,x,i)=>s+x*w[i],0);
+ const inV=diff(b.incomingVelocity,a.incomingVelocity),outV=diff(b.outgoingVelocity,a.outgoingVelocity);
+ const approach=-dot(inV,n), separating=dot(outV,n);
+ const close=(v,w)=>assert.ok(Math.abs(v-w)<=1e-12*(1+Math.max(Math.abs(v),Math.abs(w))),v+' vs '+w);
+ assert.ok(approach>0);close(separating,e*approach);
+ const inv=1/a.mass+1/b.mass;
+ close(event.impulse,(1+e)*approach/inv);
+ event.momentumAfter.forEach((value,i)=>close(value,event.momentumBefore[i]));
+ const normLoss=(1-e**2)*approach**2/(2*inv);
+ assert.ok(event.kineticEnergyAfter<=event.kineticEnergyBefore+1e-12);
+ if(!record){
+  assert.equal(event.impactFriction,undefined);close(event.kineticEnergyLost,normLoss);return;
+ }
+ const tang=event.impactFriction;
+ assert.equal(tang.coefficient,record.coefficient);
+ assert.equal(event.frictionAdmissionRevision,frictionModel.revision);
+ const beforeSlip=diff(inV,scale(n,-approach)),afterSlip=diff(outV,scale(n,separating));
+ const speed=Math.hypot(...beforeSlip), Jt=Math.min(speed/inv,record.coefficient*event.impulse);
+ assert.ok(speed>1e-6);
+ close(tang.magnitude,Jt);close(tang.slipBefore,speed);close(tang.slipAfter,Math.hypot(...afterSlip));
+ close(dot(tang.impulseOnB,n),0);
+ afterSlip.forEach((x,i)=>close(x,beforeSlip[i]*(1-inv*Jt/speed)));
+ close(tang.normalEnergyLost,normLoss);
+ close(tang.tangentialEnergyLost,Jt*(speed-.5*inv*Jt));
+ close(event.kineticEnergyLost,tang.tangentialEnergyLost+normLoss);
+}
