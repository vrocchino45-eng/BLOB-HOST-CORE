+test('pair participant insert order and equal microstep catch-up produce identical motion and one delivery',()=>{
+  const batched=setup(),split=setup();batched.seed([0,0,0],[.319,0,0]);split.seed([0,0,0],[.319,0,0]);
+  for(let i=0;i<6;i++){
